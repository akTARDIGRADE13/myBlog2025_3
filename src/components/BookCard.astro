---
import type { CoverSource, BiblioSource, BookCardData } from "../types/book";
import { getBookCardData } from "../utils/book-api";
import { getNdcLabelFromCode } from "../utils/ndc";
import type { OgpData } from "../utils/ogp";
import { fetchBooklogOgp } from "../utils/booklog-ogp";

interface BookExternalLink {
    label: string;
    url: string;
    preview?: boolean;
}

interface Props {
    isbn: string;
    coverSource?: CoverSource;
    biblioSource?: BiblioSource;
    borderColor?:
        | "stone" | "neutral" | "zinc" | "gray" | "slate"
        | "rose" | "pink" | "fuchsia" | "purple" | "violet"
        | "indigo" | "blue" | "sky" | "cyan" | "teal"
        | "emerald" | "green" | "lime" | "yellow"
        | "amber" | "orange" | "red";
    authorOverride?: string;
    links?: BookExternalLink[];
}

const {
    isbn,
    coverSource = "ndl-jpe",
    biblioSource = "openbd",
    borderColor = "neutral",
    authorOverride,
    links = [],
} = Astro.props as Props;

const data: BookCardData | null = await getBookCardData(isbn, {
    coverSource,
    biblioSource,
});

const borderClassMap: Record<NonNullable<Props["borderColor"]>, string> = {
    stone: "border-stone-300",
    neutral: "border-neutral-300",
    zinc: "border-zinc-300",
    gray: "border-gray-300",
    slate: "border-slate-300",
    rose: "border-rose-300",
    pink: "border-pink-300",
    fuchsia: "border-fuchsia-300",
    purple: "border-purple-300",
    violet: "border-violet-300",
    indigo: "border-indigo-300",
    blue: "border-blue-300",
    sky: "border-sky-300",
    cyan: "border-cyan-300",
    teal: "border-teal-300",
    emerald: "border-emerald-300",
    green: "border-green-300",
    lime: "border-lime-300",
    yellow: "border-yellow-300",
    amber: "border-amber-300",
    orange: "border-orange-300",
    red: "border-red-300",
};

const borderClass = borderClassMap[borderColor];

function normalizeIsbn13Display(isbnRaw: string): string {
    const cleaned = isbnRaw
        .toLowerCase()
        .replace(/\.jp-e$/, "")
        .replace(/[^0-9x]/g, "");

    if (cleaned.length === 13) {
        return cleaned;
    }
    return isbnRaw;
}

function getHostname(url: string): string {
    try {
        return new URL(url).hostname.replace(/^www\./, "");
    } catch {
        return url;
    }
}

const displayIsbn = data ? normalizeIsbn13Display(data.isbn) : "";

const authorsFromData = data?.authors ?? [];
const authorsDisplay =
    authorOverride && authorOverride.trim().length > 0
        ? authorOverride.trim()
        : (authorsFromData.length ? authorsFromData.join(" / ") : "不明");

const ndcLabel = data?.ndc ? getNdcLabelFromCode(data.ndc) : undefined;

const previewLink =
    links.find((link) => link.preview) ??
    links[0];

const previewOgp: OgpData | null = previewLink
    ? await fetchBooklogOgp(previewLink.url)
    : null;

const previewImageUrl = previewOgp?.image ?? null;

// console.log("[BookCard] preview", {
//     isbn,
//     previewUrl: previewLink?.url,
//     previewOgp,
//     previewImageUrl,
// });

const previewHref = previewLink?.url ?? data?.ndlLink ?? null;
const previewAlt = previewOgp?.title ?? data?.title ?? "book preview";
const previewSiteLabel =
    previewOgp?.siteName ?? (previewLink ? getHostname(previewLink.url) : null);
---

{data ? (
    <div class={`book-card max-w-xl mx-auto bg-white rounded-xl shadow-sm p-4 sm:p-5 border ${borderClass} mb-4 last:mb-0`}>
        <div class="flex items-start gap-4">
            <div class="w-24 shrink-0 sm:w-28">
                <div>
                    {previewImageUrl ? (
                        previewHref ? (
                            <a
                                href={previewHref}
                                target="_blank"
                                rel="noreferrer"
                                class="book-card-image-link block"
                            >
                                <img
                                    src={previewImageUrl}
                                    alt={previewAlt}
                                    class="h-36 w-24 rounded-md border border-gray-100 bg-gray-50 object-cover shadow-sm sm:h-40 sm:w-28"
                                    loading="lazy"
                                />
                            </a>
                        ) : (
                            <img
                                src={previewImageUrl}
                                alt={previewAlt}
                                class="h-36 w-24 rounded-md border border-gray-100 bg-gray-50 object-cover shadow-sm sm:h-40 sm:w-28"
                                loading="lazy"
                            />
                        )
                    ) : previewLink ? (
                        <a
                            href={previewHref ?? previewLink.url}
                            target="_blank"
                            rel="noreferrer"
                            class="flex h-36 w-24 items-center justify-center rounded-md border border-gray-200 bg-gray-50 p-2 text-center text-[0.72rem] leading-4 text-gray-500 transition hover:border-teal-300 hover:bg-teal-50 sm:h-40 sm:w-28"
                        >
                            {previewSiteLabel ?? "external link"}
                        </a>
                    ) : (
                        <div class="h-36 w-24 rounded-md border border-gray-200 bg-gray-50 sm:h-40 sm:w-28" />
                    )}
                </div>

                {previewLink && previewSiteLabel && (
                    <a
                        href={previewHref ?? previewLink.url}
                        target="_blank"
                        rel="noreferrer"
                        class="book-card-link mt-2 block break-words text-[0.72rem] text-gray-400 no-underline transition hover:text-gray-600"
                    >
                        {previewSiteLabel}
                    </a>
                )}
            </div>

            <div class="min-w-0 flex-1">
                <div class="flex items-start gap-3">
                    <div class="mt-1 h-6 w-1.5 shrink-0 rounded-full bg-teal-400"></div>
                    <div class="min-w-0">
                        <div class="book-card-title">
                            {data.title}
                        </div>
                    </div>
                </div>

                <div class="mt-3 space-y-2 text-sm">
                    <div class="flex gap-2">
                        <span class="min-w-[3rem] text-gray-500">著者</span>
                        <span class="text-gray-900">
                            {authorsDisplay}
                        </span>
                    </div>

                    {data.publisher && (
                        <div class="flex gap-2">
                            <span class="min-w-[3rem] text-gray-500">出版社</span>
                            <span class="text-gray-900">{data.publisher}</span>
                        </div>
                    )}

                    {data.pubdate && (
                        <div class="flex gap-2">
                            <span class="min-w-[3rem] text-gray-500">出版日</span>
                            <span class="text-gray-900">{data.pubdate}</span>
                        </div>
                    )}

                    {data.ndc && (
                        <div class="flex gap-2">
                            <span class="min-w-[3rem] text-gray-500">分類</span>
                            <span class="text-gray-900">
                                {ndcLabel ?? data.ndc}
                                {" "}
                                （{data.ndc}）
                            </span>
                        </div>
                    )}
                </div>

                <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                    <div class="flex flex-wrap gap-2">
                        {links.map((link) => (
                            <a
                                href={link.url}
                                target="_blank"
                                rel="noreferrer"
                                class:list={[
                                    "book-card-button inline-flex items-center justify-center rounded-full border px-3 py-1.5 text-xs font-medium whitespace-nowrap no-underline transition",
                                    link === previewLink
                                        ? "border-gray-300 bg-gray-50 text-gray-500 hover:bg-gray-100"
                                        : "border-gray-200 bg-white text-gray-500 hover:border-gray-300 hover:bg-gray-50 hover:text-gray-800",
                                ]}
                            >
                                {link.label}で見る
                            </a>
                        ))}
                    </div>

                    {displayIsbn && (
                        <span class="text-[0.75rem] tracking-wide text-gray-400 sm:shrink-0 sm:text-right">
                            ISBN {displayIsbn}
                        </span>
                    )}
                </div>
            </div>
        </div>

        {links.length === 0 && data.ndlLink && (
            <div class="mt-3 text-right">
                <a
                    href={data.ndlLink}
                    target="_blank"
                    rel="noreferrer"
                    class="book-card-link text-xs font-medium text-teal-600 transition hover:text-teal-800"
                >
                    国立国会図書館で見る →
                </a>
            </div>
        )}
    </div>
) : (
    <p class="text-sm text-gray-500 text-center">
        ISBN {isbn} の情報が見つかりませんでした。
    </p>
)}
