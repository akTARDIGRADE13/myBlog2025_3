---
import Layout from '../components/Layout/Layout.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import ScenerySlider from '../components/ScenerySlider.astro';

// "updates" コレクションから Markdown ファイルを取得し、日付順（新しい順）に並べ替え
const updates: CollectionEntry<'updates'>[] = await getCollection('updates');
updates.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// 最新の 3 件のみ抽出
const latestUpdates = updates.slice(0, 3);

// scenery-2026 フォルダ内の画像をまとめて取得
const sceneryModules = import.meta.glob('../assets/scenery-2026/*.{png,jpg,jpeg,webp,avif}', {
    eager: true,
    import: 'default',
});

const sceneryImages = Object.entries(sceneryModules)
    .sort(([pathA], [pathB]) => pathA.localeCompare(pathB))
    .map(([path, image]) => {
        const img = image as { src: string };
        const fileName = path.split('/').pop() ?? 'scenery';

        return {
            src: img.src,
            alt: fileName,
        };
    });
---

<Layout title="Home" description="Welcome to our website!">
	
		<!-- ヒーローセクション -->
		<section class="py-12">
    		<div class="container mx-auto px-4 md:px-8">
            <div class="grid items-center gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-10">
                <!-- 左: テキスト -->
                <div class="order-2 lg:order-1">
										<div class="flex items-center gap-4">
    										<span class="h-10 w-1.5 rounded-full bg-blue-400"></span>
    										<h1 class="text-3xl font-bold leading-tight tracking-tight text-gray-900 md:text-4xl">
        										サイトについて
    										</h1>
										</div>

                    <p class="mt-5 text-base leading-8 text-gray-700 md:text-lg">
                        勉強したことの整理や、好きなことについての記録をまとめている個人ブログです。
                    </p>

                    <div class="mt-6 space-y-4 text-base leading-8 text-gray-700 md:text-lg">
                        <p>
                            数学や物理、プログラミングなどを中心に、学んだことや考えたことを少しずつまとめています。
                        </p>
                        <p>
                            サイトの仕様や記事内容について気になる点がございましたら、下記からご連絡ください。
                        </p>
                    </div>

                    <div class="mt-6 flex flex-wrap gap-3">
                        <a
                            href="https://github.com/akTARDIGRADE13/myBlog2025_3/issues"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm transition hover:border-blue-200 hover:text-blue-600"
                        >
                            GitHub Issue
                        </a>

                        <a
                            href="https://x.com/akTARDIGRADE13"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm transition hover:border-blue-200 hover:text-blue-600"
                        >
                            X
                        </a>

                        <a
                            href="https://fedibird.com/@akTARDIGRADE13"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm transition hover:border-blue-200 hover:text-blue-600"
                        >
                            Mastodon
                        </a>

                        <a
                            href="https://qiita.com/TARDIGRADE/items/67fb257067739d106cd5"
                            class="inline-flex items-center rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm transition hover:border-blue-200 hover:text-blue-600"
                        >
                            ブログ制作記事
                        </a>
                    </div>
                </div>

                <!-- 右: スライダー -->
                <div class="order-1 lg:order-2">
                    <ScenerySlider images={sceneryImages} />
                </div>
            </div>

            <!-- 注意事項 -->
            <div class="mt-6 border-t border-gray-300 pt-4">
                <p class="text-xs leading-6 text-gray-500 md:text-sm">
                    当サイトは正確な情報の提供に努めていますが、掲載内容の正確性や最新性を保証するものではありません。
                    また、当サイトの情報に基づいて行われた判断や行動により生じたいかなる損害についても、責任を負いかねますので、あらかじめご了承ください。
                </p>
            </div>
        </div>
		</section>

		<section class="py-6">
    	<div class="container mx-auto px-4 md:px-8">
        	<div class="h-px bg-gray-400"></div>
    	</div>
		</section>
	
    <!-- 更新情報 -->
    <section class="py-12">
        <div class="container mx-auto px-4 md:px-8">
            <div class="mb-8 flex items-end justify-between gap-4">
                <div>
					<div class="flex items-center gap-4">
    					<span class="h-10 w-1.5 rounded-full bg-blue-400"></span>
    					<h1 class="text-3xl font-bold leading-tight tracking-tight text-gray-900 md:text-4xl">
    							更新情報
    					</h1>
					</div>
                    <p class="mt-5 text-base leading-8 text-gray-700 md:text-lg">
                        最新の更新を掲載しています
                    </p>
                </div>
            </div>

            <ul class="space-y-4">
                {latestUpdates.map((update) => (
                    <li class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:shadow-md">
                        <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                            <p class="text-lg font-semibold text-gray-900">
                                {update.data.title}
                            </p>
                            <p class="text-sm text-gray-500">
                                {new Date(update.data.date).toLocaleDateString('ja-JP')}
                            </p>
                        </div>
                        <p class="mt-3 text-gray-700">
                            {update.body}
                        </p>
                    </li>
                ))}
            </ul>

            <div class="mt-8 text-center">
                <a
                    href="/updates"
                    class="inline-flex items-center rounded-full border border-blue-200 px-5 py-2.5 font-medium text-blue-600 transition hover:bg-blue-50"
                >
                    全ての更新情報を見る
                </a>
            </div>
        </div>
    </section>
</Layout>
